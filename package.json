{
  "name": "food-tour",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"node server/index.mjs\" \"vite --port 5180\"",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "export": "node scripts/export-static.mjs",
    "build:pages": "vite build --config vite.pages.config.ts",
    "preview:pages": "vite preview --config vite.pages.config.ts --outDir dist-pages"
  },
  "dependencies": {
    "express": "^4.21.2",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.10.2",
    "@types/three": "^0.185.0",
    "concurrently": "^9.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
